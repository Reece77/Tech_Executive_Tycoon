{
  "openapi": "3.1.0",
  "info": {
    "title": "Tech Startup Tycoon",
    "version": "0.0.0"
  },
  "paths": {
    "/api/saves": {
      "get": {
        "tags": [
          "saves"
        ],
        "summary": "List Saves",
        "operationId": "listSaves",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SaveOut"
                  },
                  "type": "array",
                  "title": "Response Listsaves"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "saves"
        ],
        "summary": "Create Save",
        "operationId": "createSave",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSaveIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{save_id}": {
      "get": {
        "tags": [
          "saves"
        ],
        "summary": "Get Save",
        "operationId": "getSave",
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Save Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/saves/{save_id}/overview": {
      "get": {
        "tags": [
          "saves"
        ],
        "summary": "Get Overview",
        "operationId": "getOverview",
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Save Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/saves/{save_id}/advance": {
      "post": {
        "tags": [
          "saves"
        ],
        "summary": "Advance",
        "operationId": "advanceTurn",
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Save Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/meta/scenarios": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "List Scenarios",
        "operationId": "listScenarios",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioOut"
                  },
                  "type": "array",
                  "title": "Response Listscenarios"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSaveIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "description": "Save slug: a-z, 0-9, - or _"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.223372036854776e+18,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Omit to generate one"
          },
          "scenario": {
            "type": "string",
            "title": "Scenario"
          },
          "company_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Company Name"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty",
            "default": "standard"
          }
        },
        "type": "object",
        "required": [
          "name",
          "scenario",
          "company_name"
        ],
        "title": "CreateSaveIn"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "description": "Stable error body for every 4xx response."
      },
      "OverviewOut": {
        "properties": {
          "save_id": {
            "type": "string",
            "title": "Save Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "cash_cents": {
            "type": "integer",
            "title": "Cash Cents"
          },
          "monthly_burn_cents": {
            "type": "integer",
            "title": "Monthly Burn Cents"
          },
          "runway_months": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runway Months",
            "description": "Null when the company is not burning cash"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/SnapshotPointOut"
            },
            "type": "array",
            "title": "History",
            "description": "Last 12 month-end snapshots, oldest first"
          }
        },
        "type": "object",
        "required": [
          "save_id",
          "company_name",
          "turn",
          "date_label",
          "cash_cents",
          "monthly_burn_cents",
          "runway_months",
          "history"
        ],
        "title": "OverviewOut"
      },
      "SaveOut": {
        "properties": {
          "save_id": {
            "type": "string",
            "title": "Save Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          }
        },
        "type": "object",
        "required": [
          "save_id",
          "company_name",
          "scenario_id",
          "difficulty",
          "turn",
          "date_label"
        ],
        "title": "SaveOut"
      },
      "ScenarioOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "available_in": {
            "type": "string",
            "title": "Available In"
          },
          "selectable": {
            "type": "boolean",
            "title": "Selectable"
          },
          "starting_cash_cents": {
            "type": "integer",
            "title": "Starting Cash Cents"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "available_in",
          "selectable",
          "starting_cash_cents"
        ],
        "title": "ScenarioOut"
      },
      "SnapshotPointOut": {
        "properties": {
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "cash_cents": {
            "type": "integer",
            "title": "Cash Cents"
          },
          "monthly_burn_cents": {
            "type": "integer",
            "title": "Monthly Burn Cents"
          }
        },
        "type": "object",
        "required": [
          "turn",
          "date_label",
          "cash_cents",
          "monthly_burn_cents"
        ],
        "title": "SnapshotPointOut"
      }
    }
  }
}
